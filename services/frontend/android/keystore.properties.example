# Copiez ce fichier en keystore.properties (non versionné) après avoir créé votre
# keystore de release. Voir android/README.md section « Publication Play Store ».
#
#   cp keystore.properties.example keystore.properties
#
# Générer le keystore (une seule fois, à conserver précieusement) :
#   keytool -genkey -v -keystore keystore/invincible-release.keystore \
#     -alias invincible -keyalg RSA -keysize 2048 -validity 10000

storeFile=keystore/invincible-release.keystore
storePassword=remplacer_par_le_mot_de_passe_du_keystore
keyAlias=invincible
keyPassword=remplacer_par_le_mot_de_passe_de_la_cle
