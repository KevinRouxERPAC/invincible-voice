# Configuration de build production (PWA Firebase + app Android Capacitor).
# Copiez en .env.production.local et renseignez l'URL de votre backend Cloud Run.
#
#   cp .env.production.example .env.production.local
#
# L'URL ne doit PAS se terminer par /api.

NEXT_PUBLIC_BACKEND_URL=https://invincible-backend-xxxx.run.app
NEXT_OUTPUT=export
