# =============================================================================
# InvincibleVoice — secrets & config for Cloud Run deploy
# =============================================================================
# Copiez ce fichier en `.env` à la racine du dépôt, puis renseignez les valeurs.
#   Copy-Item .env.example .env
#
# Le backend ne tourne PAS sur votre PC : il est déployé sur Cloud Run
# (voir DEPLOYMENT.md). Ce fichier alimente le déploiement et les scripts.
#
# Frontend local / PWA / Android : pointez vers Cloud Run dans
#   services/frontend/.env.local  (ou .env.production.local)
#   NEXT_PUBLIC_BACKEND_URL=https://YOUR-SERVICE-xxxxx.run.app
# =============================================================================


# ---- LLM (obligatoire) ------------------------------------------------------
KYUTAI_LLM_URL=https://api.cerebras.ai/v1
KYUTAI_LLM_MODEL=qwen-3-235b-a22b-instruct-2507
KYUTAI_LLM_API_KEY=cle_cerebras_a_renseigner


# ---- STT / TTS via Gradium (voie cloud, recommandée) ------------------------
GRADIUM_API_KEY=cle_gradium_a_renseigner
TTS_SERVER=https://eu.api.gradium.ai/api/
TTS_IS_GRADIUM=true
KYUTAI_STT_URL=wss://eu.api.gradium.ai/api/speech/asr
STT_IS_GRADIUM=true
TTS_VOICE_ID=vMYQUSzm6GRkJX6d

# ---- STT / TTS via Kyutai (auto-hébergé sur GPU distant, optionnel) ---------
# STT_IS_GRADIUM=false
# TTS_IS_GRADIUM=false
# TTS_SERVER=http://votre_serveur_tts:port
# KYUTAI_STT_URL=ws://votre_serveur_stt:port
# KYUTAI_API_KEY=cle_kyutai_si_requise


# ---- Authentification -------------------------------------------------------
JWT_SECRET_KEY=remplacer_par_une_longue_chaine_aleatoire
ALLOW_PASSWORD=true

# Préférez Paramètres → Administration dans l'app déployée.
# Script (écrit dans le bucket Cloud Storage) :
#   set KYUTAI_USERS_DATA_PATH=gs://VOTRE-PROJET-invincible-data
#   uv run python scripts/create_user.py prenom.nom@exemple.com --password 'mot-de-passe-long' --language fr

ADMIN_EMAILS=admin@example.com

# ID du client OAuth « Application Web » (pas le client Android).
GOOGLE_CLIENT_ID=REPLACE_ME

ALLOW_ANONYMOUS_USER=0


# ---- Sécurité (optionnel) ---------------------------------------------------
METRICS_TOKEN=
CORS_ALLOW_ORIGINS=
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_USE_REDIS=false

# Redis Upstash (requis sur Cloud Run) — voir DEPLOYMENT.md
# REDIS_URL=rediss://default:MOT_DE_PASSE@VOTRE-HOST.upstash.io:6379

# Chemin données Cloud Run (bucket). Requis pour create_user.py.
# KYUTAI_USERS_DATA_PATH=gs://VOTRE-PROJET-invincible-data

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=remplacer_par_un_mot_de_passe
